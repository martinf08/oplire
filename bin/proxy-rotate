#!/usr/bin/env python3
"""
proxy-rotate — pool de proxies + rotation automatique sur 429.

Deux modes :

  direct  l'env pointe directement sur un proxy du pool (changement = redémarrage)
  local   l'env pointe sur un proxy local (127.0.0.1:8899) qui relaie vers le
          proxy courant du pool. La rotation est alors *à chaud* : OpenCode
          n'a pas besoin d'être redémarré.

Le veilleur (`proxy-rotate watch`) lit les 429 dans les logs OpenCode et
change de proxy automatiquement. Si le pool est vide/épuisé, il fait un
`oplire reset` (rotation WARP) en secours.

Commandes :
  init                         crée la base
  add URL [options]            ajoute un proxy
  import FICHIER               importe une liste (une URL par ligne)
  list [--all] [--json]        liste les proxies
  remove ID | enable ID | disable ID
  use ID                       applique ce proxy (mode direct)
  rotate                       proxy suivant
  429 [--warp]                 cooldown du proxy courant + rotation
  ok [ID] | fail [ID] | test [ID|--all]
  auto [on|off|status]         mode automatique (daemon + veilleur)
  start | stop | restart       gère daemon + veilleur
  daemon | watch               internes (premier plan)
  status | reset | clear | export
"""

import argparse
import base64
import fcntl
import json
import os
import re
import select
import shutil
import signal
import socket
import socketserver
import sqlite3
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timedelta, timezone
from urllib.parse import quote, urlsplit

def _default_state_dir():
    """Répertoire d'état : /root pour root, sinon XDG_DATA_HOME/oplire."""
    if os.geteuid() == 0:
        return "/root"
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "share"
    )
    return os.path.join(base, "oplire")


def _detect_lan():
    """CIDR des réseaux locaux, pour ne pas les envoyer dans le proxy."""
    try:
        out = subprocess.run(
            ["ip", "-4", "route", "show", "scope", "link"],
            capture_output=True, text=True, timeout=2,
        ).stdout
        return sorted({
            line.split()[0] for line in out.splitlines() if " proto kernel " in line
        })
    except Exception:
        return []


STATE_DIR = os.environ.get("OPLIRE_STATE_DIR", _default_state_dir())
DB_PATH = os.environ.get("OPLIRE_DB", os.path.join(STATE_DIR, "proxies.db"))
ENV_FILE = os.environ.get("OPLIRE_ENV_FILE", "/etc/opencode-proxy.env")
PROFILE_FILE = os.environ.get(
    "OPLIRE_PROFILE_FILE", "/etc/profile.d/99-opencode-proxy.sh"
)
RUN_DIR = os.environ.get("OPLIRE_RUN_DIR", "/run/proxy-rotate")
LOG_PATH = os.environ.get(
    "OPENCODE_LOG",
    os.path.join(os.path.expanduser("~"), ".local", "share", "opencode", "log", "opencode.log"),
)
SELF = os.path.abspath(__file__)

LOCAL_HOST = "127.0.0.1"
LOCAL_PORT = 8899
LOCAL_URL = f"http://{LOCAL_HOST}:{LOCAL_PORT}"

DEFAULT_COOLDOWN = 600
DEFAULT_DEAD_AFTER = 3
ROTATE_DEBOUNCE = 20          # s entre deux rotations automatiques
WARP_DEBOUNCE = 120           # s entre deux resets WARP automatiques

NO_PROXY_DEFAULT = os.environ.get(
    "OPLIRE_NO_PROXY",
    ",".join(["localhost", "127.0.0.1", "::1"] + _detect_lan()),
)

_last_warp = 0.0
_watch_lock = threading.Lock()


# ---------------------------------------------------------------- utilitaires

def now():
    return datetime.now(timezone.utc).replace(microsecond=0)


def ts(dt=None):
    return (dt or now()).strftime("%Y-%m-%d %H:%M:%S")


def say(msg=""):
    try:
        print(msg, flush=True)
    except BrokenPipeError:
        pass


def die(msg, code=1):
    print(f"Erreur : {msg}", file=sys.stderr, flush=True)
    sys.exit(code)


def connect(create=True):
    if not os.path.exists(DB_PATH):
        if not create:
            die("base absente — lancer `proxy-rotate init`")
        init_db()
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    migrate(conn)
    return conn


def init_db():
    conn = sqlite3.connect(DB_PATH)
    conn.executescript(
        """
        CREATE TABLE IF NOT EXISTS proxies (
            id             INTEGER PRIMARY KEY AUTOINCREMENT,
            label          TEXT,
            scheme         TEXT NOT NULL DEFAULT 'http',
            host           TEXT NOT NULL,
            port           INTEGER NOT NULL,
            username       TEXT,
            password       TEXT,
            country        TEXT,
            status         TEXT NOT NULL DEFAULT 'active',
            fail_count     INTEGER NOT NULL DEFAULT 0,
            ok_count       INTEGER NOT NULL DEFAULT 0,
            last_used      TEXT,
            last_ok        TEXT,
            cooldown_until TEXT,
            note           TEXT,
            source         TEXT,
            last_seen      TEXT,
            created_at     TEXT NOT NULL,
            UNIQUE (scheme, host, port, username)
        );
        CREATE TABLE IF NOT EXISTS events (
            id       INTEGER PRIMARY KEY AUTOINCREMENT,
            ts       TEXT NOT NULL,
            proxy_id INTEGER REFERENCES proxies(id) ON DELETE CASCADE,
            event    TEXT NOT NULL,
            detail   TEXT
        );
        CREATE TABLE IF NOT EXISTS settings (
            key   TEXT PRIMARY KEY,
            value TEXT
        );
        """
    )
    conn.execute(
        "INSERT OR IGNORE INTO settings(key, value) VALUES ('cooldown_seconds', ?)",
        (str(DEFAULT_COOLDOWN),),
    )
    conn.execute(
        "INSERT OR IGNORE INTO settings(key, value) VALUES ('dead_after', ?)",
        (str(DEFAULT_DEAD_AFTER),),
    )
    conn.execute("INSERT OR IGNORE INTO settings(key, value) VALUES ('mode', 'direct')")
    conn.execute("INSERT OR IGNORE INTO settings(key, value) VALUES ('freshness_seconds', '1800')")
    conn.commit()
    conn.close()
    os.chmod(DB_PATH, 0o600)
    os.makedirs(RUN_DIR, exist_ok=True)
    write_profile()


def migrate(conn):
    """Ajoute les colonnes récentes aux bases existantes."""
    cols = {row[1] for row in conn.execute("PRAGMA table_info(proxies)")}
    if "last_seen" not in cols:
        conn.execute("ALTER TABLE proxies ADD COLUMN last_seen TEXT")
    if "source" not in cols:
        conn.execute("ALTER TABLE proxies ADD COLUMN source TEXT")
    conn.commit()


def write_profile():
    os.makedirs(os.path.dirname(PROFILE_FILE), exist_ok=True)
    with open(PROFILE_FILE, "w", encoding="utf-8") as fh:
        fh.write(
            "# Chargé au login : proxy OpenCode (proxy-rotate)\n"
            f"[ -f {ENV_FILE} ] && set -a && . {ENV_FILE} && set +a\n"
        )
    os.chmod(PROFILE_FILE, 0o644)


def get_setting(conn, key, default=""):
    row = conn.execute("SELECT value FROM settings WHERE key = ?", (key,)).fetchone()
    return row["value"] if row else default


def set_setting(conn, key, value):
    conn.execute(
        "INSERT INTO settings(key, value) VALUES (?, ?) "
        "ON CONFLICT(key) DO UPDATE SET value = excluded.value",
        (key, str(value)),
    )


def log(conn, proxy_id, event, detail=None):
    conn.execute(
        "INSERT INTO events(ts, proxy_id, event, detail) VALUES (?, ?, ?, ?)",
        (ts(), proxy_id, event, detail),
    )


def proxy_url(row):
    auth = ""
    if row["username"]:
        user = quote(row["username"], safe="")
        pwd = quote(row["password"] or "", safe="")
        auth = f"{user}:{pwd}@"
    return f"{row['scheme']}://{auth}{row['host']}:{row['port']}"


def display_url(row, masked=True):
    url = proxy_url(row)
    if masked and row["password"]:
        url = url.replace(quote(row["password"], safe=""), "***")
    return url


def parse_proxy(value):
    raw = value.strip()
    if "://" not in raw:
        raw = "http://" + raw
    parts = urlsplit(raw)
    if not parts.hostname:
        raise ValueError(f"proxy invalide : {value}")
    try:
        port = parts.port or (1080 if parts.scheme.startswith("socks") else 8080)
    except ValueError:
        raise ValueError(f"port invalide : {value}")
    return {
        "scheme": parts.scheme or "http",
        "host": parts.hostname,
        "port": port,
        "username": parts.username,
        "password": parts.password,
    }


# ------------------------------------------------------------------ env/proxy

def _write_env(url, comment):
    text = (
        f"# {comment}\n"
        f"HTTPS_PROXY={url}\n"
        f"HTTP_PROXY={url}\n"
        f"ALL_PROXY={url}\n"
        f"https_proxy={url}\n"
        f"http_proxy={url}\n"
        f"all_proxy={url}\n"
        f"NO_PROXY={NO_PROXY_DEFAULT}\n"
        f"no_proxy={NO_PROXY_DEFAULT}\n"
    )
    with open(ENV_FILE, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.chmod(ENV_FILE, 0o600)
    write_profile()


def apply_direct(conn, row):
    _write_env(proxy_url(row), f"Généré par proxy-rotate le {ts()} — proxy #{row['id']}")
    conn.execute("UPDATE proxies SET last_used = ? WHERE id = ?", (ts(), row["id"]))
    set_setting(conn, "mode", "direct")
    set_setting(conn, "current_id", row["id"])
    log(conn, row["id"], "use", "direct")
    conn.commit()
    say(f"Proxy actif : #{row['id']} {display_url(row)}")
    say(f"Écrit dans {ENV_FILE}")
    say("Redémarrer OpenCode pour l'appliquer :")
    say(f"  set -a; . {ENV_FILE}; set +a")


def apply_local(conn):
    _write_env(LOCAL_URL, f"Généré par proxy-rotate le {ts()} — mode local (daemon)")
    set_setting(conn, "mode", "local")
    conn.commit()
    say(f"Mode local : OpenCode → {LOCAL_URL} → proxy courant")
    say(f"Écrit dans {ENV_FILE}")


def current_upstream_id(conn):
    if get_setting(conn, "mode", "direct") == "local":
        val = get_setting(conn, "current_id", "")
        return int(val) if str(val).isdigit() else None
    return _current_id(conn)


def _current_id(conn):
    """Retrouve l'ID du proxy présent dans l'env appliqué (mode direct)."""
    if not os.path.exists(ENV_FILE):
        return None
    try:
        with open(ENV_FILE, encoding="utf-8") as fh:
            content = fh.read()
        m = re.search(r"proxy #(\d+)", content)
        if m:
            return int(m.group(1))
        m = re.search(r"^HTTPS_PROXY=(\S+)", content, re.M)
        if not m:
            return None
        p = parse_proxy(m.group(1))
        row = conn.execute(
            """SELECT id FROM proxies WHERE scheme = ? AND host = ? AND port = ?
               AND COALESCE(username, '') = COALESCE(?, '')""",
            (p["scheme"], p["host"], p["port"], p["username"]),
        ).fetchone()
        return row["id"] if row else None
    except Exception:
        return None


def _eligible(conn, exclude=(), fresh_only=False):
    limit = ts(now())
    sql = """SELECT * FROM proxies
             WHERE status = 'active'
               AND (cooldown_until IS NULL OR cooldown_until <= ?)"""
    params = [limit]
    if fresh_only:
        ttl = int(get_setting(conn, "freshness_seconds", 1800))
        sql += " AND last_seen IS NOT NULL AND last_seen >= ?"
        params.append(ts(now() - timedelta(seconds=ttl)))
    sql += " ORDER BY last_used IS NOT NULL, last_used, id"
    rows = conn.execute(sql, params).fetchall()
    return [r for r in rows if r["id"] not in exclude]


def _pick(conn, exclude=()):
    """Proxy frais d'abord (last_seen récent), sinon n'importe quel actif."""
    rows = _eligible(conn, exclude, fresh_only=True)
    if not rows:
        rows = _eligible(conn, exclude)
    return rows[0] if rows else None


def _cooldown(conn, row):
    seconds = int(get_setting(conn, "cooldown_seconds", DEFAULT_COOLDOWN))
    until = ts(now() + timedelta(seconds=seconds))
    conn.execute(
        "UPDATE proxies SET status = 'cooldown', cooldown_until = ? WHERE id = ?",
        (until, row["id"]),
    )
    return until


def _get(conn, pid):
    row = conn.execute("SELECT * FROM proxies WHERE id = ?", (pid,)).fetchone()
    if not row:
        die(f"proxy #{pid} introuvable")
    return row


# --------------------------------------------------------------------- pid

def _pid_path(name):
    return os.path.join(RUN_DIR, f"{name}.pid")


def _read_pid(name):
    try:
        with open(_pid_path(name), encoding="utf-8") as fh:
            return int(fh.read().strip())
    except Exception:
        return None


def _write_pid(name):
    os.makedirs(RUN_DIR, exist_ok=True)
    with open(_pid_path(name), "w", encoding="utf-8") as fh:
        fh.write(str(os.getpid()))


def _alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _port_open(port=LOCAL_PORT):
    try:
        with socket.create_connection((LOCAL_HOST, port), timeout=0.5):
            return True
    except OSError:
        return False


def _spawn(name, args):
    os.makedirs(RUN_DIR, exist_ok=True)
    logf = open(os.path.join(RUN_DIR, f"{name}.log"), "ab")
    proc = subprocess.Popen(
        [sys.executable, SELF] + args,
        stdout=logf, stderr=logf, stdin=subprocess.DEVNULL,
        start_new_session=True,
    )
    return proc


def ensure_daemon():
    if _port_open():
        return _read_pid("daemon")
    pid = _read_pid("daemon")
    if pid and _alive(pid):
        return pid
    proc = _spawn("daemon", ["daemon"])
    for _ in range(20):
        if _port_open():
            break
        time.sleep(0.1)
    return proc.pid


def ensure_watch():
    pid = _read_pid("watch")
    if pid and _alive(pid):
        return pid
    proc = _spawn("watch", ["watch"])
    time.sleep(0.2)
    return proc.pid


def _stop_pid(name):
    pid = _read_pid(name)
    if not pid:
        return False
    try:
        os.kill(pid, signal.SIGTERM)
        for _ in range(20):
            if not _alive(pid):
                break
            time.sleep(0.1)
        else:
            os.kill(pid, signal.SIGKILL)
    except OSError:
        pass
    try:
        os.remove(_pid_path(name))
    except OSError:
        pass
    return True


# ------------------------------------------------------------------- daemon

_up_cache = {"t": 0.0, "row": None}


def _db_upstream():
    """Proxy courant lu dans la base (cache 1 s)."""
    t = time.time()
    if t - _up_cache["t"] < 1.0:
        return _up_cache["row"]
    row = None
    try:
        conn = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True)
        conn.row_factory = sqlite3.Row
        if get_setting(conn, "mode", "direct") == "local":
            val = get_setting(conn, "current_id", "")
            if str(val).isdigit():
                row = conn.execute(
                    "SELECT * FROM proxies WHERE id = ? AND status IN ('active','cooldown')",
                    (int(val),),
                ).fetchone()
                if row is not None:
                    row = dict(row)
        conn.close()
    except Exception:
        row = None
    _up_cache.update(t=t, row=row)
    return row


def _read_head(sock, limit=131072):
    data = b""
    while b"\r\n\r\n" not in data:
        chunk = sock.recv(4096)
        if not chunk:
            raise OSError("connexion fermée")
        data += chunk
        if len(data) > limit:
            raise OSError("en-têtes trop volumineux")
    head, _, rest = data.partition(b"\r\n\r\n")
    return head + b"\r\n\r\n", rest


def _http_connect(up, host, port):
    s = socket.create_connection((up["host"], up["port"]), timeout=15)
    req = f"CONNECT {host}:{port} HTTP/1.1\r\nHost: {host}:{port}\r\n"
    if up["username"]:
        cred = base64.b64encode(
            f"{up['username']}:{up['password'] or ''}".encode()
        ).decode()
        req += f"Proxy-Authorization: Basic {cred}\r\n"
    req += "\r\n"
    s.sendall(req.encode())
    head, rest = _read_head(s)
    if b" 200 " not in head.split(b"\r\n")[0]:
        s.close()
        raise OSError(head.split(b"\r\n")[0].decode("latin1", "replace"))
    if rest:
        s._pending = rest  # type: ignore[attr-defined]
    return s


def _socks5(up, host, port):
    s = socket.create_connection((up["host"], up["port"]), timeout=15)
    if up["username"]:
        s.sendall(b"\x05\x02\x00\x02")
        if s.recv(2)[1] != 2:
            s.close()
            raise OSError("socks5 : auth refusée")
        u = up["username"].encode()
        p = (up["password"] or "").encode()
        s.sendall(b"\x01" + bytes([len(u)]) + u + bytes([len(p)]) + p)
        if s.recv(2)[1] != 0:
            s.close()
            raise OSError("socks5 : identifiants refusés")
    else:
        s.sendall(b"\x05\x01\x00")
        if s.recv(2)[1] != 0:
            s.close()
            raise OSError("socks5 : méthode refusée")
    s.sendall(b"\x05\x01\x00\x03" + bytes([len(host)]) + host.encode()
              + port.to_bytes(2, "big"))
    resp = s.recv(10)
    if len(resp) < 2 or resp[1] != 0:
        s.close()
        raise OSError(f"socks5 : erreur {resp[1] if len(resp) > 1 else '?'}")
    return s


def _open_upstream(up, host, port):
    if up["scheme"].startswith("socks"):
        return _socks5(up, host, port)
    return _http_connect(up, host, port)


def _relay(a, b):
    socks = [a, b]
    try:
        while True:
            r, _, _ = select.select(socks, [], [], 120)
            if not r:
                break
            for s in r:
                data = s.recv(65536)
                if not data:
                    return
                (b if s is a else a).sendall(data)
    except OSError:
        pass
    finally:
        for s in socks:
            try:
                s.close()
            except OSError:
                pass


class ProxyHandler(socketserver.BaseRequestHandler):
    def handle(self):
        client = self.request
        client.settimeout(30)
        try:
            head, rest = _read_head(client)
        except OSError:
            return
        try:
            method, target, version = head.split(b"\r\n")[0].decode("latin1").split()
        except ValueError:
            return

        if method.upper() == "CONNECT":
            host, _, port = target.rpartition(":")
            try:
                port = int(port)
            except ValueError:
                client.sendall(b"HTTP/1.1 400 Bad Request\r\n\r\n")
                return
            up = _db_upstream()
            try:
                upstream = _open_upstream(up, host, port) if up else \
                    socket.create_connection((host, port), timeout=15)
            except OSError:
                client.sendall(b"HTTP/1.1 502 Bad Gateway\r\n\r\n")
                return
            client.sendall(b"HTTP/1.1 200 Connection Established\r\n\r\n")
            pending = getattr(upstream, "_pending", b"")
            if pending:
                client.sendall(pending)
            if rest:
                upstream.sendall(rest)
            _relay(client, upstream)
            return

        # HTTP en clair (rare) : forward absolu vers l'amont ou direct.
        up = _db_upstream()
        parts = urlsplit(target)
        host = parts.hostname
        port = parts.port or 80
        if not host:
            client.sendall(b"HTTP/1.1 400 Bad Request\r\n\r\n")
            return
        try:
            upstream = _open_upstream(up, host, port) if up else \
                socket.create_connection((host, port), timeout=15)
        except OSError:
            client.sendall(b"HTTP/1.1 502 Bad Gateway\r\n\r\n")
            return
        if up and not up["scheme"].startswith("socks"):
            # proxy HTTP : requête en forme absolue, avec auth éventuelle
            lines = head.split(b"\r\n")
            if up["username"]:
                cred = base64.b64encode(
                    f"{up['username']}:{up['password'] or ''}".encode()
                ).decode()
                lines.insert(1, f"Proxy-Authorization: Basic {cred}".encode())
            upstream.sendall(b"\r\n".join(lines) + rest)
        else:
            # direct : forme origine
            path = parts.path or "/"
            if parts.query:
                path += "?" + parts.query
            first = f"{method} {path} {version}".encode()
            lines = head.split(b"\r\n")
            lines[0] = first
            upstream.sendall(b"\r\n".join(lines) + rest)
        _relay(client, upstream)


class ThreadingProxy(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


def cmd_daemon(args):
    os.makedirs(RUN_DIR, exist_ok=True)
    _write_pid("daemon")
    server = ThreadingProxy((LOCAL_HOST, LOCAL_PORT), ProxyHandler)

    def _stop(signum, frame):
        threading.Thread(target=server.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)
    say(f"daemon proxy-rotate sur {LOCAL_HOST}:{LOCAL_PORT}")
    try:
        server.serve_forever(poll_interval=0.5)
    finally:
        server.server_close()
        try:
            os.remove(_pid_path("daemon"))
        except OSError:
            pass


# -------------------------------------------------------------------- watch

RATE_RE = re.compile(
    r"(QuotaExceeded|Free usage limit|rate.?limit|HTTP[^\n]*\b429\b|\b429\b)",
    re.IGNORECASE,
)


def is_rate_line(line):
    """Vrai uniquement pour une vraie ligne d'erreur OpenCode (pas une commande)."""
    if "spawning process" in line or "args=" in line or "message=\"event\"" in line:
        return False
    if "timestamp=" not in line:
        return False
    return bool(RATE_RE.search(line))


def _warp_reset():
    global _last_warp
    if time.time() - _last_warp < WARP_DEBOUNCE:
        return False
    _last_warp = time.time()
    oplire = "/usr/bin/oplire" if os.path.exists("/usr/bin/oplire") else shutil.which("oplire")
    if not oplire:
        return False
    try:
        subprocess.Popen([oplire, "reset"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError:
        return False


def auto_rotate(reason="429"):
    """Cooldown du proxy courant + passage au suivant (à chaud si mode local)."""
    conn = connect()
    cur = current_upstream_id(conn)
    if cur:
        row = _get(conn, cur)
        until = _cooldown(conn, row)
        log(conn, cur, "429", f"{reason} — cooldown jusqu'à {until}")
        conn.commit()
        say(f"[auto] #{cur} en cooldown jusqu'à {until} UTC")

    nxt = _pick(conn, exclude=(cur,) if cur else ())
    if nxt is None:
        nxt = _pick(conn)
    if nxt is None:
        say("[auto] pool épuisé → rotation WARP")
        if _warp_reset():
            log(conn, None, "warp", reason)
            conn.commit()
        return False

    if get_setting(conn, "mode", "direct") == "local":
        set_setting(conn, "current_id", nxt["id"])
        conn.execute("UPDATE proxies SET last_used = ? WHERE id = ?", (ts(), nxt["id"]))
        log(conn, nxt["id"], "rotate", f"{reason} (à chaud)")
        conn.commit()
        say(f"[auto] → #{nxt['id']} {display_url(nxt)} (sans redémarrage)")
    else:
        apply_direct(conn, nxt)
        say(f"[auto] → #{nxt['id']} {display_url(nxt)} (redémarrer OpenCode)")
    return True


def health_check():
    """Vérifie que le proxy courant répond ; sinon le met en défaut et tourne."""
    conn = connect()
    if get_setting(conn, "mode", "direct") != "local":
        return
    pid = current_upstream_id(conn)
    if not pid:
        return
    row = _get(conn, pid)
    try:
        proc = subprocess.run(
            ["curl", "-sS", "--max-time", "6", "-x", proxy_url(row),
             "-o", "/dev/null", "https://www.cloudflare.com/cdn-cgi/trace"],
            capture_output=True, timeout=10,
        )
    except Exception:
        proc = None
    if proc is not None and proc.returncode == 0:
        conn.execute(
            "UPDATE proxies SET last_seen = ?, status = 'active', fail_count = 0 "
            "WHERE id = ?",
            (ts(), pid),
        )
        conn.commit()
        return

    fails = row["fail_count"] + 1
    dead_after = int(get_setting(conn, "dead_after", DEFAULT_DEAD_AFTER))
    if fails >= dead_after:
        conn.execute(
            "UPDATE proxies SET status = 'dead', fail_count = ? WHERE id = ?",
            (fails, pid),
        )
        log(conn, pid, "dead", "health check")
    else:
        _cooldown(conn, row)
        conn.execute("UPDATE proxies SET fail_count = ? WHERE id = ?", (fails, pid))
        log(conn, pid, "fail", "health check")
    conn.commit()
    say(f"[auto] proxy #{pid} injoignable → rotation")
    auto_rotate("proxy injoignable")


def cmd_watch(args):
    os.makedirs(RUN_DIR, exist_ok=True)
    # Un seul veilleur à la fois.
    lock_fh = open(os.path.join(RUN_DIR, "watch.lock"), "w")
    try:
        fcntl.flock(lock_fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        say("veilleur déjà actif — sortie.")
        return 0
    _write_pid("watch")
    ensure_daemon()
    path = os.environ.get("PROXY_ROTATE_LOG", LOG_PATH)
    fh = None
    last = 0.0
    last_check = time.time()
    say(f"watch proxy-rotate — log : {path}")
    while True:
        if fh is None:
            if not os.path.exists(path):
                time.sleep(1)
                continue
            fh = open(path, "r", encoding="utf-8", errors="ignore")
            fh.seek(0, os.SEEK_END)
        line = fh.readline()
        if line:
            if is_rate_line(line) and time.time() - last > ROTATE_DEBOUNCE:
                last = time.time()
                try:
                    auto_rotate("429 détecté")
                except Exception as exc:  # ne jamais mourir sur une erreur
                    say(f"[auto] erreur : {exc}")
            continue
        try:
            if os.path.getsize(path) < fh.tell():
                fh.close()
                fh = None
                continue
        except OSError:
            fh.close()
            fh = None
            continue
        if not _port_open():
            ensure_daemon()
        if time.time() - last_check > 90:
            last_check = time.time()
            threading.Thread(target=health_check, daemon=True).start()
        time.sleep(0.5)


# ----------------------------------------------------------------- commandes

def cmd_init(args):
    init_db()
    say(f"Base prête : {DB_PATH}")


def cmd_add(args):
    conn = connect()
    try:
        p = parse_proxy(args.url)
    except ValueError as exc:
        die(str(exc))
    try:
        cur = conn.execute(
            """INSERT INTO proxies(label, scheme, host, port, username, password,
                                   country, note, created_at)
               VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)""",
            (args.label, p["scheme"], p["host"], p["port"], p["username"],
             p["password"], args.country, args.note, ts()),
        )
    except sqlite3.IntegrityError:
        die("ce proxy existe déjà")
    log(conn, cur.lastrowid, "add")
    conn.commit()
    say(f"Ajouté #{cur.lastrowid} : {p['scheme']}://{p['host']}:{p['port']}")


def cmd_import(args):
    if not os.path.exists(args.file):
        die(f"fichier introuvable : {args.file}")
    conn = connect()
    added = skipped = invalid = refreshed = 0
    with open(args.file, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            try:
                p = parse_proxy(line)
            except ValueError:
                invalid += 1
                continue
            try:
                cur = conn.execute(
                    """INSERT INTO proxies(scheme, host, port, username, password,
                                           last_seen, source, created_at)
                       VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
                    (p["scheme"], p["host"], p["port"], p["username"],
                     p["password"], ts(), args.source, ts()),
                )
                log(conn, cur.lastrowid, "add", "import")
                added += 1
            except sqlite3.IntegrityError:
                # Déjà en base : il vient de repasser le test, on rafraîchit.
                conn.execute(
                    """UPDATE proxies SET last_seen = ?,
                       status = CASE WHEN status = 'dead' THEN 'active' ELSE status END
                       WHERE scheme = ? AND host = ? AND port = ?
                         AND COALESCE(username, '') = COALESCE(?, '')""",
                    (ts(), p["scheme"], p["host"], p["port"], p["username"]),
                )
                refreshed += 1
    conn.commit()
    say(f"Import : {added} ajouté(s), {refreshed} rafraîchi(s), "
        f"{skipped} doublon(s), {invalid} invalide(s)")


def cmd_list(args):
    conn = connect()
    where = "" if args.all else "WHERE status != 'disabled'"
    rows = conn.execute(
        f"SELECT * FROM proxies {where} ORDER BY status, last_used IS NOT NULL, last_used, id"
    ).fetchall()
    if args.json:
        say(json.dumps([dict(r) for r in rows], ensure_ascii=False, indent=2))
        return
    if not rows:
        say("Aucun proxy. Ajouter : proxy-rotate add http://user:pass@host:port")
        return
    cur = current_upstream_id(conn)
    ttl = int(get_setting(conn, "freshness_seconds", 1800))
    cutoff = ts(now() - timedelta(seconds=ttl))
    say(f"   {'ID':>3}  {'ÉTAT':<8} {'PAYS':<5} {'VU':<16} {'OK':>3} {'KO':>3}  URL")
    for r in rows:
        if r["id"] == cur:
            mark = "*"
        elif (r["last_seen"] or "") >= cutoff:
            mark = " "
        else:
            mark = "!"
        vu = (r["last_seen"] or "-")[5:16]
        say(f"{mark}  {r['id']:>3}  {r['status']:<8} {(r['country'] or '-'):<5} "
            f"{vu:<16} {r['ok_count']:>3} {r['fail_count']:>3}  {display_url(r)}")


def cmd_remove(args):
    conn = connect()
    _get(conn, args.id)
    conn.execute("DELETE FROM proxies WHERE id = ?", (args.id,))
    if str(get_setting(conn, "current_id", "")) == str(args.id):
        set_setting(conn, "current_id", "")
    conn.commit()
    say(f"Supprimé #{args.id}")


def _set_status(args, status):
    conn = connect()
    _get(conn, args.id)
    conn.execute("UPDATE proxies SET status = ? WHERE id = ?", (status, args.id))
    log(conn, args.id, status)
    conn.commit()
    say(f"#{args.id} → {status}")


def cmd_enable(args):
    _set_status(args, "active")


def cmd_disable(args):
    _set_status(args, "disabled")


def cmd_use(args):
    conn = connect()
    row = _get(conn, args.id)
    if row["status"] != "active":
        die(f"proxy #{args.id} n'est pas actif ({row['status']})")
    apply_direct(conn, row)


def cmd_rotate(args):
    conn = connect()
    cur = current_upstream_id(conn)
    row = _pick(conn, exclude=(cur,) if cur else ())
    if row is None:
        row = _pick(conn)
    if row is None:
        say("Aucun proxy disponible.")
        if args.warp:
            say("Fallback : rotation WARP...")
            _warp_reset()
        else:
            say("Ajouter un proxy ou utiliser `proxy-rotate 429 --warp`.")
        return 1
    if get_setting(conn, "mode", "direct") == "local":
        ensure_daemon()
        set_setting(conn, "current_id", row["id"])
        conn.execute("UPDATE proxies SET last_used = ? WHERE id = ?", (ts(), row["id"]))
        log(conn, row["id"], "rotate", args.reason or "manuel (à chaud)")
        conn.commit()
        say(f"Proxy actif : #{row['id']} {display_url(row)} (rotation à chaud)")
    else:
        if args.reason:
            log(conn, row["id"], "rotate", args.reason)
        apply_direct(conn, row)
    return 0


def cmd_429(args):
    conn = connect()
    cur = current_upstream_id(conn)
    if cur:
        row = _get(conn, cur)
        until = _cooldown(conn, row)
        log(conn, cur, "429", f"cooldown jusqu'à {until}")
        conn.commit()
        say(f"#{cur} marqué 429 (cooldown jusqu'à {until} UTC)")
    else:
        say("Aucun proxy actif détecté — rotation directe.")
    return cmd_rotate(argparse.Namespace(reason="429", warp=args.warp))


def cmd_ok(args):
    conn = connect()
    pid = args.id or current_upstream_id(conn)
    if not pid:
        die("aucun proxy courant — préciser un ID")
    _get(conn, pid)
    conn.execute(
        """UPDATE proxies SET status = 'active', ok_count = ok_count + 1,
           fail_count = 0, last_ok = ?, last_seen = ?,
           cooldown_until = NULL WHERE id = ?""",
        (ts(), ts(), pid),
    )
    log(conn, pid, "ok")
    conn.commit()
    say(f"#{pid} OK")


def cmd_fail(args):
    conn = connect()
    pid = args.id or current_upstream_id(conn)
    if not pid:
        die("aucun proxy courant — préciser un ID")
    row = _get(conn, pid)
    dead_after = int(get_setting(conn, "dead_after", DEFAULT_DEAD_AFTER))
    fails = row["fail_count"] + 1
    if fails >= dead_after:
        conn.execute(
            "UPDATE proxies SET status = 'dead', fail_count = ? WHERE id = ?",
            (fails, pid),
        )
        log(conn, pid, "dead", f"{fails} échecs")
        say(f"#{pid} → dead ({fails} échecs)")
    else:
        until = _cooldown(conn, row)
        conn.execute("UPDATE proxies SET fail_count = ? WHERE id = ?", (fails, pid))
        log(conn, pid, "fail", f"échec {fails}")
        say(f"#{pid} → cooldown jusqu'à {until} UTC ({fails} échec(s))")
    conn.commit()


def cmd_test(args):
    if not shutil.which("curl"):
        die("curl requis pour tester les proxies")
    conn = connect()
    if args.all:
        rows = conn.execute("SELECT * FROM proxies ORDER BY id").fetchall()
    elif args.id:
        rows = [_get(conn, args.id)]
    else:
        pid = current_upstream_id(conn)
        if not pid:
            die("aucun proxy courant — préciser un ID ou --all")
        rows = [_get(conn, pid)]

    for row in rows:
        url = proxy_url(row)
        cmd = [
            "curl", "-fsS", "--max-time", "12", "-x", url,
            "-o", "/dev/null", "-w", "%{http_code} %{time_total}",
            "https://www.cloudflare.com/cdn-cgi/trace",
        ]
        proc = None
        try:
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
            out = proc.stdout.strip().split()
            code = out[0] if out else "000"
            elapsed = float(out[1]) if len(out) > 1 else 0.0
        except Exception:
            code, elapsed = "000", 0.0

        if proc is not None and proc.returncode == 0 and code.startswith("2"):
            conn.execute(
                """UPDATE proxies SET status = 'active', ok_count = ok_count + 1,
                   fail_count = 0, last_ok = ?, last_seen = ?, last_used = ?,
                   cooldown_until = NULL WHERE id = ?""",
                (ts(), ts(), ts(), row["id"]),
            )
            log(conn, row["id"], "test", f"ok {code} {elapsed:.2f}s")
            say(f"#{row['id']:<3} OK   {code}  {elapsed:5.2f}s  {display_url(row)}")
        else:
            fails = row["fail_count"] + 1
            dead_after = int(get_setting(conn, "dead_after", DEFAULT_DEAD_AFTER))
            if fails >= dead_after:
                conn.execute(
                    "UPDATE proxies SET status = 'dead', fail_count = ? WHERE id = ?",
                    (fails, row["id"]),
                )
                state = "dead"
            else:
                until = _cooldown(conn, row)
                conn.execute(
                    "UPDATE proxies SET fail_count = ? WHERE id = ?", (fails, row["id"])
                )
                state = f"cooldown → {until}"
            log(conn, row["id"], "test", f"échec {code}")
            say(f"#{row['id']:<3} KO   {code}  {elapsed:5.2f}s  {state}  {display_url(row)}")
        conn.commit()
    return 0


def _curl_test(url, timeout):
    try:
        proc = subprocess.run(
            ["curl", "-sS", "--max-time", str(timeout), "-x", url,
             "-o", "/dev/null", "-w", "%{http_code}",
             "https://www.cloudflare.com/cdn-cgi/trace"],
            capture_output=True, text=True, timeout=timeout + 5,
        )
        return proc.returncode == 0 and proc.stdout.strip().startswith("2")
    except Exception:
        return False


def cmd_refresh(args):
    """Re-teste tous les proxies en parallèle et met à jour la fraîcheur."""
    conn = connect()
    rows = conn.execute("SELECT * FROM proxies WHERE status != 'disabled'").fetchall()
    if not rows:
        say("Aucun proxy à rafraîchir.")
        return 0

    results = {}
    with ThreadPoolExecutor(max_workers=max(1, args.jobs)) as pool:
        futures = {pool.submit(_curl_test, proxy_url(r), args.timeout): r["id"] for r in rows}
        for fut in as_completed(futures):
            results[futures[fut]] = fut.result()

    ok = ko = 0
    dead_after = int(get_setting(conn, "dead_after", DEFAULT_DEAD_AFTER))
    for r in rows:
        if results.get(r["id"]):
            ok += 1
            conn.execute(
                """UPDATE proxies SET status = 'active', ok_count = ok_count + 1,
                   fail_count = 0, last_ok = ?, last_seen = ?,
                   cooldown_until = NULL WHERE id = ?""",
                (ts(), ts(), r["id"]),
            )
        else:
            ko += 1
            fails = r["fail_count"] + 1
            if fails >= dead_after:
                conn.execute(
                    "UPDATE proxies SET status = 'dead', fail_count = ? WHERE id = ?",
                    (fails, r["id"]),
                )
            else:
                _cooldown(conn, r)
                conn.execute(
                    "UPDATE proxies SET fail_count = ? WHERE id = ?", (fails, r["id"])
                )
    log(conn, None, "refresh", f"{ok} ok / {ko} ko")
    conn.commit()
    say(f"Refresh : {ok} OK, {ko} KO ({len(rows)} testés)")
    return 0


def cmd_auto(args):
    action = args.action or "status"
    conn = connect()

    if action == "on":
        first = _pick(conn)
        if first is None:
            say("Aucun proxy actif — mode automatique non activé.")
            return 1
        cur = current_upstream_id(conn)
        if not cur:
            set_setting(conn, "current_id", first["id"])
            conn.execute("UPDATE proxies SET last_used = ? WHERE id = ?",
                         (ts(), first["id"]))
        apply_local(conn)
        conn.commit()
        ensure_daemon()
        ensure_watch()
        say("Mode automatique actif (daemon + veilleur 429).")
        say("Relancer OpenCode pour qu'il utilise le proxy local :")
        say(f"  set -a; . {ENV_FILE}; set +a")
        return 0

    if action == "off":
        _stop_pid("watch")
        _stop_pid("daemon")
        set_setting(conn, "mode", "direct")
        conn.commit()
        try:
            os.remove(ENV_FILE)
        except OSError:
            pass
        say("Mode automatique désactivé (connexion directe/WARP).")
        return 0

    # status
    mode = get_setting(conn, "mode", "direct")
    say(f"Mode      : {mode}")
    say(f"Daemon    : {'actif' if _port_open() else 'arrêté'} ({LOCAL_URL})")
    say(f"Veilleur  : {'actif' if _alive(_read_pid('watch')) else 'arrêté'}")
    pid = current_upstream_id(conn)
    if pid:
        say(f"Courant   : #{pid} {display_url(_get(conn, pid))}")
    else:
        say("Courant   : aucun")
    if mode == "local":
        say(f"Env       : {ENV_FILE} → {LOCAL_URL}")
    return 0


def cmd_start(args):
    conn = connect()
    ensure_daemon()
    ensure_watch()
    say("Daemon + veilleur démarrés.")
    if get_setting(conn, "mode", "direct") == "local":
        say(f"OpenCode doit pointer sur {LOCAL_URL} (env : {ENV_FILE}).")


def cmd_stop(args):
    _stop_pid("watch")
    _stop_pid("daemon")
    say("Daemon + veilleur arrêtés.")


def cmd_status(args):
    conn = connect()
    counts = conn.execute(
        "SELECT status, COUNT(*) n FROM proxies GROUP BY status ORDER BY status"
    ).fetchall()
    total = sum(r["n"] for r in counts)
    say(f"Base   : {DB_PATH} — {total} proxy(ies)")
    for r in counts:
        say(f"  {r['status']:<9} {r['n']:>3}")
    ttl = int(get_setting(conn, "freshness_seconds", 1800))
    fresh = conn.execute(
        """SELECT COUNT(*) n FROM proxies WHERE status = 'active'
           AND last_seen IS NOT NULL AND last_seen >= ?""",
        (ts(now() - timedelta(seconds=ttl)),),
    ).fetchone()["n"]
    say(f"  frais     {fresh:>3}  (validés < {ttl // 60} min)")
    say(f"Mode   : {get_setting(conn, 'mode', 'direct')}")
    say(f"Daemon : {'actif' if _port_open() else 'arrêté'} — "
        f"veilleur {'actif' if _alive(_read_pid('watch')) else 'arrêté'}")
    pid = current_upstream_id(conn)
    if pid:
        say(f"Actif  : #{pid} {display_url(_get(conn, pid))}")
    else:
        say("Actif  : aucun (connexion directe / WARP)")
    say(f"Cooldown : {get_setting(conn, 'cooldown_seconds', DEFAULT_COOLDOWN)}s — "
        f"dead après {get_setting(conn, 'dead_after', DEFAULT_DEAD_AFTER)} échecs")


def cmd_reset(args):
    conn = connect()
    conn.execute(
        """UPDATE proxies SET status = 'active', fail_count = 0,
           cooldown_until = NULL WHERE status IN ('cooldown', 'dead')"""
    )
    log(conn, None, "reset", "cooldowns et compteurs remis à zéro")
    conn.commit()
    say("Cooldowns et compteurs remis à zéro.")


def cmd_prune(args):
    conn = connect()
    n = conn.execute("DELETE FROM proxies WHERE status = 'dead'").rowcount
    conn.commit()
    say(f"{n} proxy(ies) mort(s) supprimé(s).")


def cmd_clear(args):
    removed = False
    for path in (ENV_FILE, PROFILE_FILE):
        if os.path.exists(path):
            os.remove(path)
            removed = True
    conn = connect(create=False) if os.path.exists(DB_PATH) else None
    if conn:
        set_setting(conn, "mode", "direct")
        log(conn, None, "clear")
        conn.commit()
    say("Proxy retiré de l'environnement." if removed else "Aucun proxy appliqué.")


def cmd_export(args):
    conn = connect()
    rows = conn.execute(
        "SELECT * FROM proxies WHERE status = 'active' ORDER BY id"
    ).fetchall()
    if args.json:
        say(json.dumps([dict(r) for r in rows], ensure_ascii=False, indent=2))
    else:
        for r in rows:
            say(proxy_url(r))


# ---------------------------------------------------------------------- main

def main():
    parser = argparse.ArgumentParser(
        prog="proxy-rotate",
        description="Pool de proxies + rotation automatique sur 429.",
    )
    sub = parser.add_subparsers(dest="cmd")

    sub.add_parser("init", help="crée la base").set_defaults(func=cmd_init)

    p = sub.add_parser("add", help="ajoute un proxy")
    p.add_argument("url", help="host:port ou http://user:pass@host:port")
    p.add_argument("--label")
    p.add_argument("--country")
    p.add_argument("--note")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("import", help="importe une liste (une URL par ligne)")
    p.add_argument("file")
    p.add_argument("--source", default="import")
    p.set_defaults(func=cmd_import)

    p = sub.add_parser("list", help="liste les proxies")
    p.add_argument("--all", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("remove", help="supprime un proxy")
    p.add_argument("id", type=int)
    p.set_defaults(func=cmd_remove)

    p = sub.add_parser("enable", help="active un proxy")
    p.add_argument("id", type=int)
    p.set_defaults(func=cmd_enable)

    p = sub.add_parser("disable", help="désactive un proxy")
    p.add_argument("id", type=int)
    p.set_defaults(func=cmd_disable)

    p = sub.add_parser("use", help="applique un proxy (mode direct)")
    p.add_argument("id", type=int)
    p.set_defaults(func=cmd_use)

    p = sub.add_parser("rotate", help="passe au proxy suivant")
    p.add_argument("--reason")
    p.add_argument("--warp", action="store_true", help="reset WARP si pool vide")
    p.set_defaults(func=cmd_rotate)

    p = sub.add_parser("429", help="cooldown du proxy courant + rotation")
    p.add_argument("--warp", action="store_true", help="reset WARP si pool vide")
    p.set_defaults(func=cmd_429)

    p = sub.add_parser("ok", help="marque un succès")
    p.add_argument("id", type=int, nargs="?")
    p.set_defaults(func=cmd_ok)

    p = sub.add_parser("fail", help="marque un échec")
    p.add_argument("id", type=int, nargs="?")
    p.set_defaults(func=cmd_fail)

    p = sub.add_parser("test", help="teste un ou tous les proxies")
    p.add_argument("id", type=int, nargs="?")
    p.add_argument("--all", action="store_true")
    p.set_defaults(func=cmd_test)

    p = sub.add_parser("refresh", help="re-teste tous les proxies (parallèle)")
    p.add_argument("--jobs", type=int, default=20)
    p.add_argument("--timeout", type=int, default=8)
    p.set_defaults(func=cmd_refresh)

    p = sub.add_parser("auto", help="mode automatique (daemon + veilleur)")
    p.add_argument("action", nargs="?", choices=["on", "off", "status"])
    p.set_defaults(func=cmd_auto)

    sub.add_parser("start", help="démarre daemon + veilleur").set_defaults(func=cmd_start)
    sub.add_parser("stop", help="arrête daemon + veilleur").set_defaults(func=cmd_stop)

    sub.add_parser("daemon", help="proxy local (premier plan)").set_defaults(func=cmd_daemon)
    sub.add_parser("watch", help="veilleur 429 (premier plan)").set_defaults(func=cmd_watch)

    sub.add_parser("status", help="état courant").set_defaults(func=cmd_status)
    sub.add_parser("reset", help="remet cooldowns/compteurs à zéro").set_defaults(func=cmd_reset)
    sub.add_parser("prune", help="supprime les proxies morts").set_defaults(func=cmd_prune)
    sub.add_parser("clear", help="retire le proxy").set_defaults(func=cmd_clear)

    p = sub.add_parser("export", help="exporte les proxies actifs")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_export)

    args = parser.parse_args()
    if not args.cmd:
        parser.print_help()
        return 2
    return args.func(args) or 0


if __name__ == "__main__":
    try:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (AttributeError, ValueError):
        pass
    sys.exit(main())
