#!/bin/sh
# Retained as a clear migration notice for existing installations.
set -eu

case "${1-}" in
    -h|--help)
        cat <<'EOF'
proxy-hunt is disabled in this project.

It previously scraped public proxy lists and tested them for use as alternate
egress. To manage a proxy that you are authorized to use, add it explicitly
with `proxy-rotate add` and configure it for a legitimate network purpose.
HTTP 429/quota responses must not trigger proxy or WARP changes.
EOF
        ;;
    *)
        echo "proxy-hunt is disabled: public proxy collection and quota-driven rotation are not supported." >&2
        echo "Use proxy-rotate add only for an authorized proxy and a legitimate non-quota purpose." >&2
        exit 2
        ;;
esac
