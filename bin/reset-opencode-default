#!/bin/sh
# ==============================================================================
# reset-opencode-default — return the machine to its DEFAULT connection
# (without Cloudflare WARP). This legacy utility is independent of the bridge.
#
# Usage:
#   reset-opencode-default            # disconnect WARP and restore the default connection
#   reset-opencode-default --dry-run  # show actions without changing anything
#   reset-opencode-default --purge    # also remove WARP files
#                                     # (first backed up to <state>/warp-backup-*.tar.gz)
#
# This script is idempotent: running it when WARP is already off is safe.
# ==============================================================================

set -u

# Directory for WARP (wgcf) files and backups.
STATE_DIR="${OPLIRE_STATE_DIR:-/root}"

DRY=0
PURGE=0
HERE=$(basename "$0")

usage() {
    cat <<EOF
Usage: $HERE [--dry-run|-n] [--purge|-p] [--help|-h]

  (no options)    disconnect WARP and restore the default connection
  --dry-run, -n   show what would be done without making changes
  --purge, -p     also remove /etc/wireguard/wg0.conf and wgcf files
                  (backed up first to <state>/warp-backup-<date>.tar.gz)
EOF
}

for arg in "$@"; do
    case "$arg" in
        --dry-run|-n) DRY=1 ;;
        --purge|-p)   PURGE=1 ;;
        --help|-h)    usage; exit 0 ;;
        *)            echo "Unknown option: $arg" >&2; usage >&2; exit 2 ;;
    esac
done

say() { printf '%s\n' "$*"; }

# From the dev container: rerun on the host.
if [ -d /run/host ] && [ -x /run/host/usr/local/bin/reset-opencode-default ]; then
    exec chroot /run/host /usr/local/bin/reset-opencode-default "$@"
fi

if [ "$(id -u)" -ne 0 ]; then
    if [ "$DRY" -eq 0 ] && command -v doas >/dev/null 2>&1; then
        exec doas "$0" "$@"
    elif [ "$DRY" -eq 0 ] && command -v sudo >/dev/null 2>&1; then
        exec sudo "$0" "$@"
    else
        say "Error: this script must run as root." >&2
        exit 1
    fi
fi

run() {
    if [ "$DRY" -eq 1 ]; then
        say "  [dry-run] $*"
    else
        "$@" >/dev/null 2>&1 || true
    fi
}

say "=================================================="
say "  Returning to the default connection (without WARP)"
say "=================================================="

# 1. Stop the Oplire daemon/proxy if it is running.
say "[1/5] Stopping the Oplire daemon..."
if [ "$DRY" -eq 1 ]; then
    say "  [dry-run] oplire stop"
else
    oplire stop >/dev/null 2>&1 || true
    pkill -f 'oplire (watch|daemon)' 2>/dev/null || true
fi

# 2. Bring down the WireGuard tunnel.
say "[2/5] Disabling the wg0 tunnel..."
if ip link show wg0 >/dev/null 2>&1; then
    if [ "$DRY" -eq 1 ]; then
        say "  [dry-run] wg-quick down wg0"
    else
        wg-quick down wg0 >/dev/null 2>&1 || ip link del wg0 >/dev/null 2>&1 || true
        warp-cli disconnect >/dev/null 2>&1 || true
    fi
else
    say "  -> wg0 is already absent"
fi

# 3. Clean up routing rules left by wg-quick / warp-cli.
say "[3/5] Cleaning up routing rules..."
LAN=$(ip -4 route show scope link 2>/dev/null | awk '/proto kernel/ {print $1}' | paste -sd, -)
[ -n "$LAN" ] || LAN="" 

cleanup_rule() {
    # $1 = exact rule pattern, $2 = priority
    if ip rule show 2>/dev/null | grep -q "priority $2"; then
        if [ "$DRY" -eq 1 ]; then
            say "  [dry-run] ip rule del priority $2"
        else
            ip rule del priority "$2" >/dev/null 2>&1 || true
        fi
    fi
}
[ -n "$LAN" ] && cleanup_rule "to $LAN lookup main" 100
# wg-quick adds these two rules for fwmark 0xca6c; they are removed by
# `wg-quick down`, but clean up leftovers after an abrupt shutdown.
if ip rule show 2>/dev/null | grep -q 'lookup 51820'; then
    PRIO=$(ip rule show | awk '/lookup 51820/ {gsub(":", "", $1); print $1; exit}')
    [ -n "$PRIO" ] && cleanup_rule "" "$PRIO"
fi
if ip rule show 2>/dev/null | grep -q 'suppress_prefixlength 0'; then
    PRIO=$(ip rule show | awk '/suppress_prefixlength 0/ {gsub(":", "", $1); print $1; exit}')
    [ -n "$PRIO" ] && cleanup_rule "" "$PRIO"
fi

# 4. Verify default route, DNS, public IP, and warp=off.
say "[4/5] Verifying the default connection..."
DEFROUTE=$(ip route show default 2>/dev/null | grep -v ' dev wg0' | head -n 1)
if [ -n "$DEFROUTE" ]; then
    say "  -> Default route: $DEFROUTE"
else
    say "  -> [WARNING] no default route outside wg0" >&2
fi

NS=$(awk '/^nameserver/ {print $2; exit}' /etc/resolv.conf 2>/dev/null)
say "  -> DNS: ${NS:-absent}"

TRACE=$(curl -fsS --max-time 10 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null || true)
IP=$(printf '%s\n' "$TRACE" | grep '^ip=' | cut -d= -f2)
WARP_STATE=$(printf '%s\n' "$TRACE" | grep '^warp=' | cut -d= -f2)

if [ "$DRY" -eq 1 ]; then
    say "  [dry-run] network check skipped (current state: warp=${WARP_STATE:-unknown}, ip=${IP:-unknown})"
elif [ "$WARP_STATE" = "off" ]; then
    say "  -> WARP: OFF (default connection)"
    say "  -> Public IP: ${IP:-unknown}"
elif [ -z "$WARP_STATE" ]; then
    say "  -> [WARNING] no response from the network check" >&2
else
    say "  -> [ERROR] WARP is still active (warp=$WARP_STATE, ip=${IP:-?})" >&2
    exit 1
fi

# 5. Optionally purge WARP files.
if [ "$PURGE" -eq 1 ]; then
    say "[5/5] Removing WARP files (after backing them up)..."
    STAMP=$(date +%Y%m%d-%H%M%S)
    BACKUP="$STATE_DIR/warp-backup-$STAMP.tar.gz"
    FILES="/etc/wireguard/wg0.conf $STATE_DIR/wgcf-account.toml $STATE_DIR/wgcf-profile.conf /var/lib/cloudflare-warp"
    if [ "$DRY" -eq 1 ]; then
        say "  [dry-run] tar czf $BACKUP $FILES"
        say "  [dry-run] rm -f /etc/wireguard/wg0.conf $STATE_DIR/wgcf-account.toml $STATE_DIR/wgcf-profile.conf"
        say "  [dry-run] rm -rf /var/lib/cloudflare-warp"
    else
        # shellcheck disable=SC2086
        tar czf "$BACKUP" $FILES 2>/dev/null || true
        rm -f /etc/wireguard/wg0.conf "$STATE_DIR/wgcf-account.toml" "$STATE_DIR/wgcf-profile.conf"
        rm -rf /var/lib/cloudflare-warp
        say "  -> Backup: $BACKUP"
    fi
else
    say "[5/5] WARP files retained (use --purge to remove them)."
fi

say "=================================================="
if [ "$DRY" -eq 1 ]; then
    say "  Dry run complete: no changes were made."
else
    say "  Default connection restored (WARP disconnected)."
    say "  To re-enable a tunnel, use your WARP provider's administration tool."
fi
say "=================================================="
