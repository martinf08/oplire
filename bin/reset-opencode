#!/bin/sh
# Legacy-compatible launcher name. It does not reset networking, test a model,
# retry requests, or change proxies when a provider reports HTTP 429.
set -eu

case "${1-}" in
    --fast|-f|--no-hunt|--default|-d|--proxy|-p)
        echo "Legacy reset/rotation options are disabled; respect provider limits." >&2
        exit 2
        ;;
esac

if [ "${1-}" = "--check" ]; then
    [ "$#" -ge 2 ] || {
        echo "Usage: reset-opencode [--check URL] [arguments OpenCode...]" >&2
        exit 2
    }
    check_url=$2
    shift 2
    command -v oplire >/dev/null 2>&1 || {
        echo "oplire was not found; install the binary to use --check." >&2
        exit 127
    }
    oplire check --url "$check_url"
    [ "$#" -gt 0 ] || exit 0
fi

command -v opencode >/dev/null 2>&1 || {
    echo "opencode was not found in PATH." >&2
    exit 127
}

exec opencode "$@"
