#!/sbin/openrc-run
# Connectivity watcher; HTTP 429 is reported without switching proxies.
# The watcher also starts the local proxy (127.0.0.1:8899) when needed.

name="proxy-rotate"
description="Connectivity watcher for configured Oplire proxies"

command="/usr/local/bin/proxy-rotate"
command_args="watch"
command_background=true
pidfile="/run/proxy-rotate/watch.pid"
output_log="/var/log/proxy-rotate.log"
error_log="/var/log/proxy-rotate.log"

depend() {
    need net
    after firewall
}

start_pre() {
    mkdir -p /run/proxy-rotate
    checkpath --file --mode 0644 /var/log/proxy-rotate.log
}
